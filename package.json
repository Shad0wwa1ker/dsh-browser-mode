{
  "name": "@local/dsh-browser-mode",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "A DeepSeek Harness bundle: a visible-browser Agent preset, a runtime-switchable browser source (Edge / bundled Chromium / CDP endpoint) with a settings page in the plugins view, and a gate that keeps browser tools out of every other Session until the user agrees.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shad0wwa1ker/dsh-browser-mode.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "browser",
    "playwright",
    "agent-preset"
  ],
  "exports": {
    ".": "./index.js",
    "./browser-gate": "./browser-gate.js",
    "./browser-source": "./browser-source.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "browser-gate.js",
    "browser-source.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
